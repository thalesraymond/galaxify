{
    "name": "galaxify",
    "private": true,
    "scripts": {
        "dev": "pnpm --parallel --filter @galaxify/* run dev",
        "build": "pnpm --filter @galaxify/* run build",
        "lint": "pnpm --filter @galaxify/* run lint",
        "test": "pnpm --filter @galaxify/* run test"
    },
    "devDependencies": {
        "@eslint/js": "^9.38.0",
        "@typescript-eslint/eslint-plugin": "^8.46.1",
        "@typescript-eslint/parser": "^8.46.1",
        "eslint": "^9.38.0",
        "globals": "^16.4.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.1",
        "vite": "^7.1.11",
        "vitest": "^3.2.4"
    },
    "workspaces": {
        "packages": [
            "api",
            "web"
        ]
