{
    "name": "galaxify",
    "private": true,
    "scripts": {
        "dev": "pnpm --parallel --filter @galaxify/* run dev",
        "build": "pnpm --filter @galaxify/* run build",
        "lint": "pnpm --filter @galaxify/* run lint"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.46.1",
        "@typescript-eslint/parser": "^8.46.1",
        "eslint": "^9.38.0",
        "globals": "^16.3.0",
        "typescript": "^5.9.3",
        "vite": "^7.1.11",
        "vitest": "^3.2.4"
    },
    "pnpm": {
        "workspaces": [
            "packages/*"
        ],
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    }
}
