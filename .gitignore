# ################################################################# #
# Arquivo .gitignore para um Monorepo com PNPM, MERN-like stack:    #
# - Backend: Express.js + TypeScript                              #
# - Frontend: Next.js + TypeScript + Tailwind CSS                 #
# ################################################################# #

# === Dependências ===
# A pasta node_modules contém todas as dependências do projeto.
# Ela é recriada com 'pnpm install' e nunca deve ser versionada.
node_modules
**/node_modules

# === Arquivos de Lock de outros Gerenciadores ===
# Como estamos usando PNPM, ignoramos os arquivos de lock do NPM e Yarn
# para evitar conflitos. O 'pnpm-lock.yaml' DEVE ser versionado.
package-lock.json
yarn.lock


# === Logs ===
# Arquivos de log podem conter informações sensíveis e são específicos do ambiente.
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# === Arquivos de Ambiente ===
# NUNCA versione arquivos .env. Eles contêm segredos como chaves de API,
# senhas de banco de dados, etc.
# Em vez disso, crie um arquivo .env.example com as variáveis necessárias
# e adicione-o ao controle de versão.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local


# === Build e Arquivos Compilados ===
# Pastas de output de builds. O código nelas é gerado a partir do código-fonte.

# Para o backend (Express.js + TypeScript)
# Geralmente o output do TypeScript vai para uma pasta 'dist' ou 'build'.
dist
build
out

# Para o frontend (Next.js)
# O Next.js usa a pasta .next para seus arquivos de build e cache.
.next

# Arquivo de cache de build do TypeScript
tsconfig.tsbuildinfo
*.tsbuildinfo


# === Testes ===
# Relatórios de cobertura de testes e outros artefatos.
coverage
.nyc_output


# === Arquivos de Sistema Operacional ===
# Arquivos específicos de cada sistema operacional que não pertencem ao projeto.
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
*.lnk


# === Arquivos de IDEs e Editores ===
# Configurações pessoais de ambiente de desenvolvimento.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

.gemini